# Copy this file to `.env` and fill in real values.
#
# Anything prefixed with VITE_ is inlined into the bundle at BUILD time.
# Changing it requires a rebuild, not just a restart of the dev server.
# Never put a server-side secret here — everything in this file ships to browsers.

# Required. Clerk publishable key, from your Clerk dashboard → API Keys.
# Use a pk_test_ key in development and a pk_live_ key in production:
# development keys are restricted to localhost origins and will fail on a
# real domain. The app throws "Missing VITE_CLERK_PUBLISHABLE_KEY" at startup
# if this is unset.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Optional. Base URL of the Express backend. Defaults to http://localhost:4000
# when unset. No trailing slash needed — it is stripped at runtime.
# Must be set to your deployed backend URL before building for production.
VITE_API_URL=http://localhost:4000